# ==============================================================================
# SyncPad Environment Variables Configuration
# ==============================================================================
# Instructions:
# 1. Create a free Supabase project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy your Project URL and anon / public API key below
# 4. Save a copy of this file as .env.local for local development,
#    or add these in the Netlify site dashboard under Site Configuration -> Environment Variables.
#
# NOTE: Variables prefixed with VITE_ are embedded into the client bundle.
# NEVER put your Supabase service_role secret key in VITE_ variables!
# ==============================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: If your project uses the newer publishable key format:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
